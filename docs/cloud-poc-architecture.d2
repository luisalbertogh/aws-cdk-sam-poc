# Cloud POC AWS CDK Architecture Diagram
# This diagram depicts the overall AWS infrastructure defined by the CDK code
# UPDATED: Now includes active API Gateway, Step Functions, and Lambda functions

direction: right

# Define reusable classes for styling
classes: {
  active: {
    style: {
      fill: "#e8f5e9"
      stroke: "#4caf50"
      stroke-width: 3
      font-size: 40
      bold: true
    }
  }
  
  inactive: {
    style: {
      fill: "#f5f5f5"
      stroke: "#9e9e9e"
      stroke-width: 2
      stroke-dash: 5
      font-size: 40
      bold: true
    }
  }
  
  resource: {
    style: {
      font-size: 35
      bold: false
      fill: "#ffffff"
      stroke: "#2196f3"
      stroke-width: 2
    }
  }
  
  lambda: {
    style: {
      fill: "#fff3e0"
      stroke: "#ff9800"
      stroke-width: 3
      font-size: 38
      bold: true
    }
  }
}

# AWS Region container
aws-region: {
  label: AWS Region (eu-central-1)
  icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/aws_region.svg
  style: {
    font-size: 55
    fill: "#e3f2fd"
    stroke: "#1976d2"
    stroke-width: 3
  }
  
  # API Gateway Stack - ACTIVE
  api-stack: {
    label: "API Stack\n(CloudPocApiStack)\n[ACTIVE]"
    class: active
    icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/api_gateway_red.svg
    
    # API Gateway
    apigw: {
      label: "API Gateway\nCloudPocChefApi\nPOST /chef"
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/api_gateway_red.svg
      class: resource
    }
    
    # API Key
    apikey: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/iam_role.svg
      label: "API Key\nAuthentication"
      class: resource
      style: {
        font-size: 30
      }
    }
    
    # CloudWatch Logs for API
    api-logs: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/cloud_watch.svg
      label: "CloudWatch Logs\n/aws/apigateway/CloudPocChefApi"
      class: resource
      style: {
        font-size: 30
      }
    }
  }
  
  # Orchestration Stack - NOW ACTIVE
  orchestration-stack: {
    label: "Orchestration Stack\n(CloudPocOrchestrationStack)\n[ACTIVE]"
    class: active
    icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/scheduler.svg
    
    # Step Functions
    sfn: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/scheduler.svg
      label: "Step Functions\nHelloWorldStateMachine\n(Chef Workflow)"
      class: resource
    }
    
    # CloudWatch Logs for SFN
    sfn-logs: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/cloud_watch.svg
      label: "CloudWatch Logs\nState Machine Logs"
      class: resource
      style: {
        font-size: 30
      }
    }
    
    # IAM Role
    sfn-role: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/iam_role.svg
      label: "IAM Role\nExecution Role"
      class: resource
      style: {
        font-size: 30
      }
    }
  }
  
  # Network Stack - ACTIVE
  network-stack: {
    label: "Network Stack\n(CloudPocNetworkStack)\n[ACTIVE]"
    class: active
    icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/vpc.svg
    
    # VPC
    vpc: {
      label: "VPC\n10.0.0.0/27"
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/vpc.svg
      class: resource
      
      # Internet Gateway
      igw: {
        shape: image
        icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/internet_gw.svg
        label: "Internet Gateway"
        class: resource
        style: {
          font-size: 30
        }
      }
      
      # Public Subnets
      subnet1: {
        shape: image
        icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/public_subnet.svg
        label: "Public Subnet 1\nAZ-1"
        class: resource
        style: {
          font-size: 30
        }
      }
      
      subnet2: {
        shape: image
        icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/public_subnet.svg
        label: "Public Subnet 2\nAZ-2"
        class: resource
        style: {
          font-size: 30
        }
      }
      
      # Security Group
      sg: {
        shape: image
        icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/waf.svg
        label: "Security Group\nchef-ui-sg"
        class: resource
        style: {
          font-size: 30
        }
      }
    }
  }
  
  # Cluster Stack - ACTIVE
  cluster-stack: {
    label: "Cluster Stack\n(CloudPocClusterStack)\n[ACTIVE]"
    class: active
    icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/ecs.svg
    
    # ECS Cluster
    cluster: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/ecs.svg
      label: "ECS Fargate Cluster\n(Infrastructure Ready)"
      class: resource
    }
  }
  
  # Storage Stack - ACTIVE
  storage-stack: {
    label: "Storage Stack\n(CloudPocStorageStack)\n[ACTIVE]"
    class: active
    icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/s3_bucket.svg
    
    # S3 Bucket
    s3: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/s3_bucket.svg
      label: "S3 Bucket\nSSE-S3 Encryption\nPrivate Access"
      class: resource
    }
  }
  
  # Registry Stack - ACTIVE
  registry-stack: {
    label: "Registry Stack\n(CloudPocRegistryStack)\n[ACTIVE]"
    class: active
    icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/ecr.svg
    
    # ECR Repository
    ecr-registry: {
      label: "ECR Registry"
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/ecr_registry.svg
      class: resource
      
      # Individual repositories
      chef-ui-repo: {
        shape: image
        icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/ecr.svg
        label: "chef-ui\nrepository"
        style: {
          font-size: 28
        }
      }
      
      chef-agent-repo: {
        shape: image
        icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/ecr.svg
        label: "chef-agent\nrepository"
        style: {
          font-size: 28
        }
      }
      
      nutritionist-repo: {
        shape: image
        icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/ecr.svg
        label: "nutritionist-agent\nrepository"
        style: {
          font-size: 28
        }
      }
      
      instructor-repo: {
        shape: image
        icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/ecr.svg
        label: "instructor-agent\nrepository"
        style: {
          font-size: 28
        }
      }
    }
  }
  
  # Secrets Stack - ACTIVE
  secrets-stack: {
    label: "Secrets Stack\n(CloudPocSecretsStack)\n[ACTIVE]"
    class: active
    icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/secrets.svg
    
    # Secrets Manager Secret
    secret: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/secrets.svg
      label: "Secrets Manager\nchef-ui-login-passwords\n(Chainlit Auth)"
      class: resource
    }
  }
  
  # ECS Stack - INACTIVE (commented out)
  ecs-stack: {
    label: "ECS Stack\n(CloudPocEcsStack)\n[COMMENTED OUT]"
    class: inactive
    icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/ecs.svg
    
    # ECS Service
    ecs-service: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/ecs_service.svg
      label: "Chef UI Service\nFargate (ARM64)\n0.5 vCPU, 2GB RAM"
      class: resource
      style: {
        font-size: 30
      }
    }
    
    # CloudWatch Logs for ECS
    ecs-logs: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/cloud_watch.svg
      label: "CloudWatch Logs\n/aws/ecs/chef-ui"
      class: resource
      style: {
        font-size: 28
      }
    }
    
    # IAM Task Role
    task-role: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/iam_role.svg
      label: "IAM Task Role\nchef-ui-task-role"
      class: resource
      style: {
        font-size: 28
      }
    }
  }
}

# Lambda Functions (SAM-deployed, outside main region container for clarity)
lambda-functions: {
  label: "Lambda Functions\n(SAM-deployed)"
  class: lambda
  icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/lambda.svg
  
  # ChefApp Lambda
  chef-lambda: {
    shape: image
    icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/lambda.svg
    label: "ChefApp Lambda\nCloudCorePocChefAppStack-ChefApp\nPython 3.12 ARM64"
    style: {
      font-size: 32
    }
  }
  
  # OFFAPI Lambda
  offapi-lambda: {
    shape: image
    icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/lambda.svg
    label: "OFFAPI Lambda\nCloudPocOpenFoodFactsAPIStack-OFFAPICaller\nPython 3.12 ARM64"
    style: {
      font-size: 32
    }
  }
}

# External Users
users: {
  shape: image
  icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/users.svg
  label: "Internet Users"
  style: {
    font-size: 45
  }
}

# Internet
internet: {
  shape: image
  icon: ../../../.copilot/skills/d2-sketcher/assets/icons/others/internet.svg
  label: "Internet"
  style: {
    font-size: 45
  }
}

# CI/CD Pipeline
cicd: {
  shape: image
  icon: ../../../.copilot/skills/d2-sketcher/assets/icons/others/github.svg
  label: "GitHub Actions\nCI/CD Pipeline"
  style: {
    font-size: 45
  }
}

# External API
open-food-facts: {
  shape: image
  icon: ../../../.copilot/skills/d2-sketcher/assets/icons/others/internet.svg
  label: "Open Food Facts API\n(External)"
  style: {
    font-size: 40
  }
}

# ============================================================================
# ACTIVE INFRASTRUCTURE CONNECTIONS
# ============================================================================

# User to API Gateway flow
users -> internet: "HTTPS\nRequests" {
  style: {
    font-size: 35
    stroke: "#4caf50"
    stroke-width: 4
    bold: true
  }
}

internet -> aws-region.api-stack.apigw: "POST /chef\n(with API Key)" {
  style: {
    font-size: 35
    stroke: "#4caf50"
    stroke-width: 4
    bold: true
  }
}

# API Gateway to Step Functions
aws-region.api-stack.apigw -> aws-region.orchestration-stack.sfn: "starts\nexecution" {
  style: {
    font-size: 35
    stroke: "#4caf50"
    stroke-width: 4
    bold: true
  }
}

# Step Functions to Lambda functions
aws-region.orchestration-stack.sfn -> lambda-functions.chef-lambda: "1. invokes\nChefApp" {
  style: {
    font-size: 35
    stroke: "#ff9800"
    stroke-width: 4
    bold: true
  }
}

lambda-functions.chef-lambda -> aws-region.orchestration-stack.sfn: "returns\nsuggestions" {
  style: {
    font-size: 35
    stroke: "#ff9800"
    stroke-width: 3
    stroke-dash: 3
  }
}

aws-region.orchestration-stack.sfn -> lambda-functions.offapi-lambda: "2. invokes\nOFFAPI\n(conditional)" {
  style: {
    font-size: 35
    stroke: "#ff9800"
    stroke-width: 4
    bold: true
  }
}

lambda-functions.offapi-lambda -> aws-region.orchestration-stack.sfn: "returns\nnutritional data" {
  style: {
    font-size: 35
    stroke: "#ff9800"
    stroke-width: 3
    stroke-dash: 3
  }
}

# OFFAPI Lambda calls external API
lambda-functions.offapi-lambda -> open-food-facts: "queries\nproducts" {
  style: {
    font-size: 35
    stroke: "#2196f3"
    stroke-width: 3
  }
}

# Step Functions to CloudWatch
aws-region.orchestration-stack.sfn -> aws-region.orchestration-stack.sfn-logs: "sends logs" {
  style: {
    font-size: 32
    stroke: "#4caf50"
    stroke-width: 2
  }
}

# API Gateway to CloudWatch
aws-region.api-stack.apigw -> aws-region.api-stack.api-logs: "access logs" {
  style: {
    font-size: 32
    stroke: "#4caf50"
    stroke-width: 2
  }
}

# Internet to VPC (for future ECS)
internet -> aws-region.network-stack.vpc.igw: "via IGW\n(ready)" {
  style: {
    font-size: 32
    stroke: "#4caf50"
    stroke-width: 2
  }
}

# IGW to Subnets
aws-region.network-stack.vpc.igw -> aws-region.network-stack.vpc.subnet1: "routes" {
  style: {
    font-size: 30
    stroke: "#4caf50"
    stroke-width: 2
  }
}

aws-region.network-stack.vpc.igw -> aws-region.network-stack.vpc.subnet2: "routes" {
  style: {
    font-size: 30
    stroke: "#4caf50"
    stroke-width: 2
  }
}

# Security Group protects subnets
aws-region.network-stack.vpc.sg -> aws-region.network-stack.vpc.subnet1: "protects" {
  style: {
    font-size: 30
    stroke: "#4caf50"
    stroke-width: 2
    stroke-dash: 3
  }
}

aws-region.network-stack.vpc.sg -> aws-region.network-stack.vpc.subnet2: "protects" {
  style: {
    font-size: 30
    stroke: "#4caf50"
    stroke-width: 2
    stroke-dash: 3
  }
}

# CI/CD to ECR
cicd -> aws-region.registry-stack.ecr-registry: "pushes\nimages" {
  style: {
    font-size: 32
    stroke: "#4caf50"
    stroke-width: 3
    animated: true
  }
}

# ============================================================================
# INACTIVE INFRASTRUCTURE CONNECTIONS (if ECS enabled)
# ============================================================================

# ECS Service would pull from ECR
aws-region.ecs-stack.ecs-service -> aws-region.registry-stack.ecr-registry.chef-ui-repo: "pulls image" {
  style: {
    font-size: 32
    stroke: "#9e9e9e"
    stroke-width: 2
    stroke-dash: 5
  }
}

# ECS Service would use Secrets
aws-region.ecs-stack.ecs-service -> aws-region.secrets-stack.secret: "reads\ncredentials" {
  style: {
    font-size: 32
    stroke: "#9e9e9e"
    stroke-width: 2
    stroke-dash: 5
  }
}

# ECS Service would run in VPC
aws-region.network-stack.vpc.subnet1 -> aws-region.ecs-stack.ecs-service: "hosts tasks" {
  style: {
    font-size: 32
    stroke: "#9e9e9e"
    stroke-width: 2
    stroke-dash: 5
  }
}

# ECS would send logs to CloudWatch
aws-region.ecs-stack.ecs-service -> aws-region.ecs-stack.ecs-logs: "sends logs" {
  style: {
    font-size: 32
    stroke: "#9e9e9e"
    stroke-width: 2
    stroke-dash: 5
  }
}

# ECS Service would invoke Step Functions
aws-region.ecs-stack.ecs-service -> aws-region.orchestration-stack.sfn: "starts\nexecutions" {
  style: {
    font-size: 32
    stroke: "#9e9e9e"
    stroke-width: 2
    stroke-dash: 5
  }
}

# ECS would use Cluster
aws-region.cluster-stack.cluster -> aws-region.ecs-stack.ecs-service: "hosts" {
  style: {
    font-size: 32
    stroke: "#9e9e9e"
    stroke-width: 2
    stroke-dash: 5
  }
}

# Legend
legend: {
  label: "Legend"
  style: {
    font-size: 50
    bold: true
    stroke: "#000000"
    stroke-width: 2
  }
  
  active-box: {
    label: "Active Stack\n(Deployed)"
    class: active
    style: {
      font-size: 35
    }
  }
  
  lambda-box: {
    label: "Lambda Function\n(SAM-deployed)"
    class: lambda
    style: {
      font-size: 35
    }
  }
  
  inactive-box: {
    label: "Inactive Stack\n(Commented Out)"
    class: inactive
    style: {
      font-size: 35
    }
  }
  
  connection-active: {
    label: "Active Connection"
    shape: text
    style: {
      font-size: 32
    }
  }
  
  connection-inactive: {
    label: "Inactive Connection"
    shape: text
    style: {
      font-size: 32
    }
  }
  
  # Show connection examples
  connection-active -> connection-inactive: {
    style: {
      stroke: "#4caf50"
      stroke-width: 3
    }
  }
  
  connection-inactive -> active-box: {
    style: {
      stroke: "#9e9e9e"
      stroke-width: 2
      stroke-dash: 5
    }
  }
}

