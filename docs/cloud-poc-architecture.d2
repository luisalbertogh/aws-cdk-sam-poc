# Cloud POC AWS CDK Architecture Diagram
# Depicts the active AWS infrastructure defined by the CDK code (7 stacks + 2 SAM Lambda functions)
# ECS Fargate service stack is omitted (commented out in app.py)

direction: right

# ============================================================================
# REUSABLE STYLE CLASSES
# ============================================================================

classes: {
  # Style for active CDK stacks
  active: {
    style: {
      fill: "#e8f5e9"
      stroke: "#4caf50"
      stroke-width: 3
      font-size: 40
      bold: true
    }
  }

  # Style for AWS resources inside stacks
  resource: {
    style: {
      font-size: 35
      bold: false
      fill: "#ffffff"
      stroke: "#2196f3"
      stroke-width: 2
    }
  }

  # Style for SAM-deployed Lambda functions
  lambda: {
    style: {
      fill: "#fff3e0"
      stroke: "#ff9800"
      stroke-width: 3
      font-size: 40
      bold: true
    }
  }

  # Invisible spacer for grid layout
  invisible: {
    style.opacity: 0
    label: ""
  }
}

# ============================================================================
# EXTERNAL ACTORS
# ============================================================================

# Internet users who call the API
users: {
  shape: image
  icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/users.svg
  label: "Internet Users"
  style: {
    font-size: 45
  }
}

# Internet (routing layer)
internet: {
  shape: image
  icon: ../../../.copilot/skills/d2-sketcher/assets/icons/others/internet.svg
  label: "Internet"
  style: {
    font-size: 45
  }
}

# CI/CD pipeline that pushes images to ECR
cicd: {
  shape: image
  icon: ../../../.copilot/skills/d2-sketcher/assets/icons/others/github.svg
  label: "GitHub Actions\nCI/CD Pipeline"
  style: {
    font-size: 45
  }
}

# Third-party nutritional data provider
open-food-facts: {
  shape: image
  icon: ../../../.copilot/skills/d2-sketcher/assets/icons/others/internet.svg
  label: "Open Food Facts API\n(External)"
  style: {
    font-size: 40
  }
}

# ============================================================================
# AWS REGION BOUNDARY
# ============================================================================

aws-region: {
  label: "AWS Region (eu-central-1)"
  icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/aws_region.svg
  style: {
    font-size: 55
    fill: "#e3f2fd"
    stroke: "#1976d2"
    stroke-width: 3
  }

  # --------------------------------------------------------------------------
  # API STACK — REST API Gateway entry point with API Key auth and throttling
  # --------------------------------------------------------------------------
  api-stack: {
    label: "API Stack\n(CloudPocApiStack)"
    class: active
    icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/api_gateway_red.svg

    # REST API handling POST /chef with X-Ray tracing enabled
    apigw: {
      label: "API Gateway\nCloudPocChefApi\nREST · POST /chef · prod"
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/api_gateway_red.svg
      class: resource
    }

    # API key required on the /chef POST method
    apikey: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/iam_role.svg
      label: "API Key\nCloudPocChefApiKey"
      class: resource
      style: {
        font-size: 30
      }
    }

    # Usage plan with rate and burst throttling
    usageplan: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/iam_policies.svg
      label: "Usage Plan\n10 req/s · burst 20"
      class: resource
      style: {
        font-size: 30
      }
    }

    # Access log group for the API Gateway stage
    api-logs: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/cloud_watch.svg
      label: "CloudWatch Logs\n/aws/apigateway/CloudPocChefApi"
      class: resource
      style: {
        font-size: 30
      }
    }
  }

  # --------------------------------------------------------------------------
  # ORCHESTRATION STACK — Step Functions workflow with X-Ray and CloudWatch
  # --------------------------------------------------------------------------
  orchestration-stack: {
    label: "Orchestration Stack\n(CloudPocOrchestrationStack)"
    class: active
    icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/scheduler.svg

    # State machine implementing the chef workflow (InvokeChefLambda → CheckSuggestions → InvokeNextLambda)
    sfn: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/scheduler.svg
      label: "Step Functions\nHelloWorldStateMachine"
      class: resource
    }

    # CloudWatch log group capturing ALL-level execution data
    sfn-logs: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/cloud_watch.svg
      label: "CloudWatch Logs\nState Machine Logs"
      class: resource
      style: {
        font-size: 30
      }
    }

    # IAM role granting Step Functions permission to invoke Lambda and write logs
    sfn-role: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/iam_role.svg
      label: "IAM Role\nSFN Execution Role"
      class: resource
      style: {
        font-size: 30
      }
    }
  }

  # --------------------------------------------------------------------------
  # NETWORK STACK — VPC with public subnets and internet gateway
  # --------------------------------------------------------------------------
  network-stack: {
    label: "Network Stack\n(CloudPocNetworkStack)"
    class: active
    icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/vpc.svg

    # VPC 10.0.0.0/27 — minimal CIDR for POC, 0 NAT Gateways
    vpc: {
      label: "VPC\n10.0.0.0/27"
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/vpc.svg
      class: resource

      # Internet gateway providing outbound/inbound internet access
      igw: {
        shape: image
        icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/internet_gw.svg
        label: "Internet Gateway"
        class: resource
        style: {
          font-size: 30
        }
      }

      # Public subnet in AZ-1 (/28 — 16 IPs)
      subnet1: {
        shape: image
        icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/public_subnet.svg
        label: "Public Subnet 1\nAZ-1 /28"
        class: resource
        style: {
          font-size: 30
        }
      }

      # Public subnet in AZ-2 (/28 — 16 IPs)
      subnet2: {
        shape: image
        icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/public_subnet.svg
        label: "Public Subnet 2\nAZ-2 /28"
        class: resource
        style: {
          font-size: 30
        }
      }

      # Security group chef-ui-sg allowing ports 80/443/8080/8443
      sg: {
        shape: image
        icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/waf.svg
        label: "Security Group\nchef-ui-sg"
        class: resource
        style: {
          font-size: 30
        }
      }
    }
  }

  # --------------------------------------------------------------------------
  # CLUSTER STACK — ECS Fargate cluster (no services deployed yet)
  # --------------------------------------------------------------------------
  cluster-stack: {
    label: "Cluster Stack\n(CloudPocClusterStack)"
    class: active
    icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/ecs.svg

    # Fargate cluster — infrastructure ready for future ECS service deployment
    cluster: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/ecs.svg
      label: "ECS Fargate Cluster\nchef-assistant-cluster"
      class: resource
    }

    # Task execution role with ECS, ECR, Secrets Manager, and CloudWatch permissions
    exec-role: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/iam_role.svg
      label: "IAM Task Execution Role\nchef-ui-ecs-task-execution-role"
      class: resource
      style: {
        font-size: 30
      }
    }
  }

  # --------------------------------------------------------------------------
  # STORAGE STACK — Private S3 bucket with SSE-S3 encryption
  # --------------------------------------------------------------------------
  storage-stack: {
    label: "Storage Stack\n(CloudPocStorageStack)"
    class: active
    icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/s3_bucket.svg

    # Auto-named S3 bucket — SSE-S3, block all public access, SSL enforced
    s3: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/s3_bucket.svg
      label: "S3 Bucket\nSSE-S3 · Private · SSL"
      class: resource
    }
  }

  # --------------------------------------------------------------------------
  # REGISTRY STACK — ECR repository for Chef UI container images
  # --------------------------------------------------------------------------
  registry-stack: {
    label: "Registry Stack\n(CloudPocRegistryStack)"
    class: active
    icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/ecr.svg

    # ECR repo for chef-ui images — scan on push enabled, 1-day untagged expiry
    chef-ui-repo: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/ecr.svg
      label: "ECR Repository\nchef-ui"
      class: resource
    }
  }

  # --------------------------------------------------------------------------
  # SECRETS STACK — Secrets Manager for Chainlit auth credentials
  # --------------------------------------------------------------------------
  secrets-stack: {
    label: "Secrets Stack\n(CloudPocSecretsStack)"
    class: active
    icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/secrets.svg

    # RETAIN policy — never destroyed; holds CHAINLIT_AUTH_SECRET, user, password
    secret: {
      shape: image
      icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/secrets.svg
      label: "Secrets Manager\nchef-ui-login-passwords"
      class: resource
    }
  }
}

# ============================================================================
# LAMBDA FUNCTIONS (SAM-deployed — outside CDK stacks)
# ============================================================================

lambda-functions: {
  label: "Lambda Functions\n(SAM-deployed)"
  class: lambda
  icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/lambda.svg

  # ChefApp Lambda — returns dish suggestions (Python 3.12 ARM64)
  chef-lambda: {
    shape: image
    icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/lambda.svg
    label: "ChefApp Lambda\nPython 3.12 · ARM64"
    style: {
      font-size: 32
    }
  }

  # OFFAPI Lambda — queries Open Food Facts for nutritional data (Python 3.12 ARM64)
  offapi-lambda: {
    shape: image
    icon: ../../../.copilot/skills/d2-sketcher/assets/icons/aws/lambda.svg
    label: "OFFAPI Lambda\nPython 3.12 · ARM64"
    style: {
      font-size: 32
    }
  }
}

# ============================================================================
# CONNECTIONS — MAIN REQUEST FLOW
# ============================================================================

# Users reach the API via HTTPS through the internet
users -> internet: "HTTPS\nRequests" {
  style: {
    font-size: 35
    stroke: "#4caf50"
    stroke-width: 4
    bold: true
  }
}

# Internet routes POST /chef with API Key to API Gateway
internet -> aws-region.api-stack.apigw: "POST /chef\n(API Key)" {
  style: {
    font-size: 35
    stroke: "#4caf50"
    stroke-width: 4
    bold: true
  }
}

# API Gateway starts a Step Functions execution (direct service integration)
aws-region.api-stack.apigw -> aws-region.orchestration-stack.sfn: "starts\nexecution" {
  style: {
    font-size: 35
    stroke: "#4caf50"
    stroke-width: 4
    bold: true
  }
}

# ============================================================================
# CONNECTIONS — WORKFLOW ORCHESTRATION
# ============================================================================

# Step 1: State machine invokes ChefApp Lambda for dish suggestions
aws-region.orchestration-stack.sfn -> lambda-functions.chef-lambda: "1. invoke\nChefApp" {
  style: {
    font-size: 35
    stroke: "#ff9800"
    stroke-width: 4
    bold: true
  }
}

# ChefApp returns suggestions back to the state machine
lambda-functions.chef-lambda -> aws-region.orchestration-stack.sfn: "dish\nsuggestions" {
  style: {
    font-size: 35
    stroke: "#ff9800"
    stroke-width: 3
    stroke-dash: 3
  }
}

# Step 2 (conditional): State machine invokes OFFAPI if sugerencias is absent
aws-region.orchestration-stack.sfn -> lambda-functions.offapi-lambda: "2. invoke\nOFFAPI (conditional)" {
  style: {
    font-size: 35
    stroke: "#ff9800"
    stroke-width: 4
    bold: true
  }
}

# OFFAPI returns nutritional data back to the state machine
lambda-functions.offapi-lambda -> aws-region.orchestration-stack.sfn: "nutritional\ndata" {
  style: {
    font-size: 35
    stroke: "#ff9800"
    stroke-width: 3
    stroke-dash: 3
  }
}

# OFFAPI Lambda queries the external Open Food Facts REST API
lambda-functions.offapi-lambda -> open-food-facts: "queries\nproducts" {
  style: {
    font-size: 35
    stroke: "#2196f3"
    stroke-width: 3
  }
}

# ============================================================================
# CONNECTIONS — OBSERVABILITY (CloudWatch logs)
# ============================================================================

# Step Functions emits execution logs to CloudWatch
aws-region.orchestration-stack.sfn -> aws-region.orchestration-stack.sfn-logs: "execution\nlogs" {
  style: {
    font-size: 32
    stroke: "#4caf50"
    stroke-width: 2
  }
}

# API Gateway emits access logs to CloudWatch
aws-region.api-stack.apigw -> aws-region.api-stack.api-logs: "access\nlogs" {
  style: {
    font-size: 32
    stroke: "#4caf50"
    stroke-width: 2
  }
}

# ============================================================================
# CONNECTIONS — NETWORK ROUTING
# ============================================================================

# Internet traffic enters the VPC through the Internet Gateway
internet -> aws-region.network-stack.vpc.igw: "routes\nvia IGW" {
  style: {
    font-size: 32
    stroke: "#4caf50"
    stroke-width: 2
  }
}

# IGW forwards traffic to both public subnets
aws-region.network-stack.vpc.igw -> aws-region.network-stack.vpc.subnet1: "routes" {
  style: {
    font-size: 30
    stroke: "#4caf50"
    stroke-width: 2
  }
}

aws-region.network-stack.vpc.igw -> aws-region.network-stack.vpc.subnet2: "routes" {
  style: {
    font-size: 30
    stroke: "#4caf50"
    stroke-width: 2
  }
}

# Security group guards both public subnets (ports 80/443/8080/8443)
aws-region.network-stack.vpc.sg -> aws-region.network-stack.vpc.subnet1: "protects" {
  style: {
    font-size: 30
    stroke: "#4caf50"
    stroke-width: 2
    stroke-dash: 3
  }
}

aws-region.network-stack.vpc.sg -> aws-region.network-stack.vpc.subnet2: "protects" {
  style: {
    font-size: 30
    stroke: "#4caf50"
    stroke-width: 2
    stroke-dash: 3
  }
}

# ============================================================================
# CONNECTIONS — CI/CD & SECRETS
# ============================================================================

# GitHub Actions pushes container images to the ECR repository
cicd -> aws-region.registry-stack.chef-ui-repo: "pushes\nimages" {
  style: {
    font-size: 32
    stroke: "#4caf50"
    stroke-width: 3
    animated: true
  }
}

# ECS task execution role reads Chainlit auth credentials at runtime
aws-region.cluster-stack.exec-role -> aws-region.secrets-stack.secret: "reads\nsecrets" {
  style: {
    font-size: 32
    stroke: "#9c27b0"
    stroke-width: 2
    stroke-dash: 3
  }
}

# ============================================================================
# LEGEND
# ============================================================================

legend: {
  label: "Legend"
  style: {
    font-size: 50
    bold: true
    stroke: "#000000"
    stroke-width: 2
  }

  # Active CDK stack indicator
  active-box: {
    label: "Active CDK Stack\n(Deployed)"
    class: active
    style: {
      font-size: 35
    }
  }

  # SAM-deployed Lambda function indicator
  lambda-box: {
    label: "Lambda Function\n(SAM-deployed)"
    class: lambda
    style: {
      font-size: 35
    }
  }

  # Active connection flow indicator
  conn-active: {
    label: "Active Connection"
    shape: text
    style: {
      font-size: 32
    }
  }

  # Conditional / auxiliary connection indicator
  conn-dashed: {
    label: "Conditional / Aux"
    shape: text
    style: {
      font-size: 32
    }
  }

  # Connection style samples
  conn-active -> conn-dashed: {
    style: {
      stroke: "#4caf50"
      stroke-width: 3
    }
  }

  conn-dashed -> lambda-box: {
    style: {
      stroke: "#ff9800"
      stroke-width: 2
      stroke-dash: 3
    }
  }
}
