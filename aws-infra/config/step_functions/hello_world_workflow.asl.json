{
  "Comment": "Chef App workflow - Invoke Lambda for dish suggestions and validate response",
  "StartAt": "InvokeChefLambda",
  "States": {
    "InvokeChefLambda": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ChefLambdaArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "statusCode.$": "$.Payload.statusCode",
        "body.$": "States.StringToJson($.Payload.body)"
      },
      "ResultPath": "$.lambdaResult",
      "Next": "CheckSuggestions",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "LambdaError"
        }
      ]
    },
    "CheckSuggestions": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.lambdaResult.body.sugerencias",
          "IsPresent": true,
          "Next": "ReturnSuggestions"
        }
      ],
      "Default": "InvokeNextLambda"
    },
    "ReturnSuggestions": {
      "Type": "Pass",
      "InputPath": "$.lambdaResult.body",
      "End": true
    },
    "InvokeNextLambda": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${NextLambdaArn}",
        "Payload": {
          "product_names.$": "States.Array($.lambdaResult.body.plato)",
          "limit": 3
        }
      },
      "ResultSelector": {
        "statusCode.$": "$.Payload.statusCode",
        "body.$": "States.StringToJson($.Payload.body)"
      },
      "ResultPath": "$.finalResult",
      "Next": "ReturnFinalResult",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "LambdaError"
        }
      ]
    },
    "ReturnFinalResult": {
      "Type": "Pass",
      "InputPath": "$.finalResult.body",
      "End": true
    },
    "LambdaError": {
      "Type": "Fail",
      "Error": "LambdaInvocationError",
      "Cause": "Failed to invoke Lambda function"
    }
  }
}
